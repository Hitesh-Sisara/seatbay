{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seatbay-website",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "routes": [
    { "pattern": "seatbay.sisara.in", "custom_domain": true }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
